{
    "version": "1.35.1",
    "name": "pkgbld",
    "license": "MIT",
    "author": "Konstantin Shutkin",
    "bin": "./index.js",
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "types"
    ],
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kshutkin/package-build.git",
        "directory": "pkgbld"
    },
    "bugs": "https://github.com/kshutkin/package-build/issues",
    "homepage": "https://github.com/kshutkin/package-build/blob/main/pkgbld/README.md",
    "readme": "README.md",
    "keywords": [
        "pkgbld",
        "build",
        "exports",
        "rollup"
    ],
    "scripts": {
        "build": "rollup -c && dts-buddy types/index.d.ts -m pkgbld:src/index.js",
        "lint": "eslint ./src",
        "prepack": "pkgprn --remove-sourcemaps",
        "test": "c8 --src=. --all -r=html node --env-file=ci.env tests/test.js"
    },
    "dependencies": {
        "@niceties/logger": "catalog:",
        "@niceties/draftlog-appender": "catalog:",
        "lodash": "catalog:",
        "rollup": "catalog:",
        "rollup-plugin-typescript2": "catalog:",
        "rollup-plugin-preprocess": "catalog:",
        "@rollup/plugin-commonjs": "catalog:",
        "@rollup/plugin-terser": "catalog:",
        "@rollup/plugin-json": "catalog:",
        "@rollup/plugin-node-resolve": "catalog:",
        "@rollup-extras/plugin-clean": "catalog:",
        "@rollup-extras/plugin-binify": "catalog:",
        "@rollup-extras/plugin-externals": "catalog:",
        "@slimlib/refine-partition": "catalog:",
        "@slimlib/smart-mock": "^0.1.6",
        "is-builtin-module": "catalog:",
        "terser": "^5.39.0",
        "@niceties/ansi": "catalog:",
        "@niceties/node-parseargs-plus": "catalog:"
    },
    "devDependencies": {
        "@types/lodash": "catalog:",
        "type-fest": "catalog:",
        "dts-buddy": "catalog:",
        "pkgprn": "^0.8.0",
        "options": "workspace:*",
        "c8": "catalog:",
        "cli-test-helper": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "catalog:"
    }
}
