{
    "version": "1.8.2",
    "name": "pkgbld-internal",
    "description": "Special version of pkgbld to install it in MY workspace-enabled repositories to build in-house packages",
    "license": "MIT",
    "author": "Konstantin Shutkin",
    "bin": "./index.js",
    "main": "./dist/index.mjs",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kshutkin/package-build.git",
        "directory": "pkgbld-internal"
    },
    "bugs": "https://github.com/kshutkin/package-build/issues",
    "homepage": "https://github.com/kshutkin/package-build/blob/main/pkgbld-internal/README.md",
    "readme": "README.md",
    "scripts": {
        "build": "rollup -c",
        "lint": "eslint ./src",
        "prepack": "node ./index.js prune"
    },
    "dependencies": {
        "lodash": "catalog:",
        "rollup": "catalog:",
        "@rollup/plugin-terser": "catalog:",
        "rollup-plugin-typescript2": "catalog:",
        "rollup-plugin-preprocess": "catalog:",
        "@rollup/plugin-commonjs": "catalog:",
        "@rollup/plugin-node-resolve": "catalog:",
        "@rollup/plugin-json": "catalog:",
        "is-builtin-module": "catalog:",
        "kleur": "catalog:",
        "draftlog": "^1.0.13",
        "pkg-dir": "^5.0.0",
        "cleye": "catalog:",
        "jsonata": "catalog:",
        "@niceties/logger": "catalog:",
        "@niceties/draftlog-appender": "catalog:",
        "@slimlib/refine-partition": "catalog:"
    },
    "peerDependencies": {
        "typescript": ">=5.3.3"
    },
    "devDependencies": {
        "@rollup-extras/plugin-binify": "catalog:",
        "@rollup-extras/plugin-clean": "catalog:",
        "@rollup/plugin-replace": "^6.0.0",
        "pkgbld": "workspace:*",
        "@rollup-extras/plugin-externals": "catalog:"
    }
}
